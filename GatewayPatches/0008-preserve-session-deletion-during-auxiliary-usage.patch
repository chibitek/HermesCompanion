+
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            future = executor.submit(finish_background_response)
+            try:
+                assert ready.wait(10), "Background response never became ready"
+                assert db.delete_session("deleted-chat")
+            finally:
+                deleted.set()
+            assert future.result(timeout=10) is False
+        assert db.get_session("deleted-chat") is None
+        assert _usage_rows(db, "deleted-chat") == []
