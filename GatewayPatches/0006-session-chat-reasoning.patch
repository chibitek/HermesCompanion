@@ -1004,3 +1004,62 @@ async def test_patch_session_still_rejects_unknown_fields(adapter, session_db):
         resp = await cli.patch(f"/api/sessions/{session_id}", json={"nonsense": 1})
         assert resp.status == 400, await resp.text()
         assert (await resp.json())["error"]["code"] == "unsupported_session_field"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("suffix", ["/chat", "/chat/stream"])
+async def test_turn_reasoning_override_preserves_conversation_options(adapter, session_db, suffix):
+    import json
+    from gateway.platforms.api_server import _request_reasoning_config
+    session_id = session_db.create_session("reasoning-turn", "api_server")
+    options = {"reasoning": {"enabled": True, "effort": "high"}, "service_tier": "priority"}
+    session_db.update_session_runtime_lock(session_id, model="local-model", provider="local",
+                                         model_options=options, confirmed=True)
+    before = json.loads(session_db.get_session(session_id)["model_config"])
+    captured = []
+
+    async def run(**kwargs):
+        captured.append(kwargs)
+        return {"final_response": "ok", "session_id": session_id}, {}
+
+    with patch.object(adapter, "_run_agent", side_effect=run):
+        async with TestClient(TestServer(_create_session_app(adapter))) as cli:
+            for effort, expected in [("none", {"enabled": False}), ("low", {"enabled": True, "effort": "low"}),
+                                     ("default", None), (None, options["reasoning"])]:
+                body = {"message": "hello"}
+                if effort is not None:
+                    body["reasoning_effort"] = effort
+                response = await cli.post(f"/api/sessions/{session_id}{suffix}", json=body)
+                assert response.status == 200, await response.text()
+                await response.text()
+                actual = captured[-1]["model_options"]
+                assert _request_reasoning_config(actual) == expected
+                assert actual["service_tier"] == options["service_tier"]
+                assert captured[-1]["requested_model"] == "local-model"
+                assert json.loads(session_db.get_session(session_id)["model_config"]) == before
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("suffix", ["/chat", "/chat/stream"])
+async def test_invalid_turn_reasoning_is_rejected_before_agent_or_lock_write(adapter, session_db, suffix):
+    session_id = session_db.create_session("invalid-reasoning-turn", "api_server")
+    before = session_db.get_session(session_id)["model_config"]
+    with patch.object(adapter, "_run_agent", new_callable=AsyncMock) as run:
+        async with TestClient(TestServer(_create_session_app(adapter))) as cli:
+            for effort in [True, 2, {}, [], None, "", "turbo"]:
+                response = await cli.post(f"/api/sessions/{session_id}{suffix}",
+                                         json={"message": "hello", "reasoning_effort": effort})
+                assert response.status == 400, await response.text()
+                assert (await response.json())["error"]["code"] == "invalid_reasoning_effort"
+    run.assert_not_called()
+    assert session_db.get_session(session_id)["model_config"] == before
+
+
+def test_reasoning_runtime_reports_only_known_configuration_fields(adapter):
+    from types import SimpleNamespace
+    for effort in [[], {}, "unknown"]:
+        agent = SimpleNamespace(provider="local", model="local-model", reasoning_config={
+            "enabled": False, "effort": effort, "private_configuration": "must-not-appear"})
+        result = adapter._turn_runtime_metadata(agent, route=None, requested_runtime=None,
+                                                route_source="global", confirmed_runtime_lock=False)
+        assert result["reasoning"] == {"enabled": False}
