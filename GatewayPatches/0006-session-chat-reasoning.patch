diff --git a/gateway/platforms/api_server_reasoning.py b/gateway/platforms/api_server_reasoning.py
new file mode 100644
index 0000000000..e2a01ba500
--- /dev/null
+++ b/gateway/platforms/api_server_reasoning.py
@@ -0,0 +1,34 @@
+"""Per-turn session reasoning overrides that never rewrite persisted model options."""
+from typing import Any, Dict, Optional
+
+from hermes_constants import VALID_REASONING_EFFORTS
+
+
+def parse_turn_reasoning(body: Dict[str, Any]) -> Optional[str]:
+    if "reasoning_effort" not in body:
+        return None
+    value = body["reasoning_effort"]
+    if not isinstance(value, str) or value not in {"default", "none", *VALID_REASONING_EFFORTS}:
+        raise ValueError("reasoning_effort must be default, none, minimal, low, medium, high, xhigh, max, or ultra")
+    return value
+
+
+def apply_turn_reasoning(options: Any, effort: str) -> Dict[str, Any]:
+    # A sparse model_options replacement would erase settings chosen by another client.
+    result = dict(options or {})
+    result.pop("reasoning", None)
+    result.pop("reasoning_effort", None)
+    if effort != "default":
+        result["reasoning"] = {"enabled": False} if effort == "none" else {"enabled": True, "effort": effort}
+    return result
+
+
+def public_reasoning_config(value: Any) -> Optional[Dict[str, Any]]:
+    if not isinstance(value, dict):
+        return None
+    result = {}
+    if type(value.get("enabled")) is bool:
+        result["enabled"] = value["enabled"]
+    if isinstance(value.get("effort"), str) and value["effort"] in VALID_REASONING_EFFORTS:
+        result["effort"] = value["effort"]
+    return result or None
diff --git a/tests/gateway/test_session_api.py b/tests/gateway/test_session_api.py
