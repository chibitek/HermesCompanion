+    @pytest.mark.asyncio
+    @pytest.mark.parametrize("available", [False, True])
+    async def test_job_capability_matches_module_and_registered_routes(self, adapter, monkeypatch, available):
+        import gateway.platforms.api_server as api
+        monkeypatch.setattr(api, "_CRON_AVAILABLE", available)
+        app = _create_app(adapter)
+        app.router.add_get("/api/jobs", adapter._handle_list_jobs)
+        async with TestClient(TestServer(app)) as cli:
+            response = await cli.get("/v1/capabilities")
+            data = await response.json()
+            assert data["features"]["jobs_admin"] is available
+            registered = {(method, path) for method, path, _ in adapter._http_route_table()}
+            advertised = {(item["method"], item["path"]) for item in data["endpoints"].values()
+                          if item["path"].startswith("/api/jobs")}
+            expected = {(method, path) for method, path in registered if path.startswith("/api/jobs")}
+            assert advertised == expected
+            jobs = await cli.get("/api/jobs?include_disabled=true")
+            assert jobs.status == (200 if available else 501)
