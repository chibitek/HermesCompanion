diff --git a/tests/gateway/test_api_server_run_progress.py b/tests/gateway/test_api_server_run_progress.py
new file mode 100644
index 0000000000..16fdfe2af8
--- /dev/null
+++ b/tests/gateway/test_api_server_run_progress.py
@@ -0,0 +1,84 @@
+"""Durable HTTP runs expose lifecycle waits and never call interruptions completed."""
+import asyncio
+import threading
+from unittest.mock import MagicMock
+
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("interrupted", [False, True])
+async def test_lifecycle_wait_is_pollable_and_interruption_is_terminal(monkeypatch, interrupted):
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={"key": "test-key"}))
+    release, ready = threading.Event(), threading.Event()
+    agent = MagicMock()
+    agent.status_callback = None
+    agent.session_prompt_tokens = agent.session_completion_tokens = agent.session_total_tokens = 0
+
+    def run_conversation(**kwargs):
+        if agent.status_callback is not None:
+            agent.status_callback("lifecycle", "Waiting for another Hermes process. Authorization: Bearer super-secret-test-token")
+        ready.set()
+        assert release.wait(10)
+        return {"final_response": "Stopped before processing" if interrupted else "Finished",
+                "interrupted": interrupted, "completed": not interrupted}
+
+    agent.run_conversation.side_effect = run_conversation
+    callbacks = {}
+
+    def create_agent(**kwargs):
+        callbacks.update(kwargs)
+        return agent
+
+    monkeypatch.setattr(adapter, "_create_agent", create_agent)
+    app = web.Application()
+    app.router.add_post("/v1/runs", adapter._handle_runs)
+    app.router.add_get("/v1/runs/{run_id}", adapter._handle_get_run)
+    app.router.add_get("/v1/runs/{run_id}/events", adapter._handle_run_events)
+    async with TestClient(TestServer(app), headers={"Authorization": "Bearer test-key"}) as client:
+        admission = await client.post("/v1/runs", json={"input": "test lifecycle"})
+        assert admission.status == 202
+        run_id = (await admission.json())["run_id"]
+        try:
+            assert await asyncio.to_thread(ready.wait, 3)
+            snapshot = await (await client.get(f"/v1/runs/{run_id}")).json()
+            assert snapshot["progress_kind"] == "lifecycle"
+            assert "Waiting for another Hermes process" in snapshot["progress_message"]
+            assert "super-secret-test-token" not in snapshot["progress_message"]
+            assert snapshot["progress_at"] > 0
+            stream = await client.get(f"/v1/runs/{run_id}/events")
+            frame = (await asyncio.wait_for(stream.content.readuntil(b"\n\n"), 3)).decode()
+            assert '"run.progress"' in frame
+            assert "Waiting for another Hermes process" in frame
+            assert "super-secret-test-token" not in frame
+            if not interrupted:
+                callbacks["stream_delta_callback"]("Response started")
+                delta = (await asyncio.wait_for(stream.content.readuntil(b"\n\n"), 3)).decode()
+                assert '"message.delta"' in delta
+                responding = await (await client.get(f"/v1/runs/{run_id}")).json()
+                assert responding.get("progress_message") is None
+                assert responding["last_event"] == "message.delta"
+            release.set()
+            ending = await asyncio.wait_for(stream.text(), 3)
+            expected = "interrupted" if interrupted else "completed"
+            assert f'"run.{expected}"' in ending
+            snapshot = await (await client.get(f"/v1/runs/{run_id}")).json()
+            assert snapshot["status"] == expected
+            assert snapshot.get("progress_message") is None
+            assert snapshot["output"] == ("Stopped before processing" if interrupted else "Finished")
+            # A delayed producer must not resurrect a finished run or reintroduce its wait.
+            agent.status_callback("lifecycle", "Late callback")
+            await asyncio.sleep(0)
+            late = await (await client.get(f"/v1/runs/{run_id}")).json()
+            assert late["status"] == expected
+            assert late.get("progress_message") is None
+        finally:
+            release.set()
+            task = adapter._active_run_tasks.get(run_id)
+            if task is not None:
+                await asyncio.wait_for(asyncio.shield(task), 3)
+            adapter._run_idempotency_store.close()
