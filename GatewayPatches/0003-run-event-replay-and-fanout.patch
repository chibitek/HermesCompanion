diff --git a/tests/gateway/test_api_server_run_fanout.py b/tests/gateway/test_api_server_run_fanout.py
new file mode 100644
index 0000000000..efa3e3d86f
--- /dev/null
+++ b/tests/gateway/test_api_server_run_fanout.py
@@ -0,0 +1,103 @@
+"""Two viewers of one run must not consume each other's events or cleanup state."""
+import asyncio
+import json
+import threading
+from unittest.mock import MagicMock
+
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+
+def decoded(frame):
+    return json.loads(next(line[6:] for line in frame.decode().splitlines() if line.startswith("data: ")))
+
+
+@pytest.mark.asyncio
+async def test_two_clients_reconnect_without_losing_run_events(monkeypatch):
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={"key": "test-key"}))
+    release = threading.Event()
+    ready = threading.Event()
+    callbacks = {}
+    agent = MagicMock()
+    agent.session_prompt_tokens = agent.session_completion_tokens = agent.session_total_tokens = 0
+
+    def run_conversation(**kwargs):
+        ready.set()
+        assert release.wait(10), "test did not release the controlled run"
+        return {"final_response": "First second"}
+
+    agent.run_conversation.side_effect = run_conversation
+
+    def create_agent(**kwargs):
+        callbacks.update(kwargs)
+        return agent
+
+    monkeypatch.setattr(adapter, "_create_agent", create_agent)
+    app = web.Application()
+    app.router.add_post("/v1/runs", adapter._handle_runs)
+    app.router.add_get("/v1/runs/{run_id}/events", adapter._handle_run_events)
+    app.router.add_get("/v1/runs/{run_id}", adapter._handle_get_run)
+    async with TestClient(TestServer(app), headers={"Authorization": "Bearer test-key"}) as client:
+        started = await client.post("/v1/runs", json={"input": "controlled test"})
+        assert started.status == 202, await started.text()
+        run_id = (await started.json())["run_id"]
+        path = f"/v1/runs/{run_id}/events"
+        try:
+            assert await asyncio.to_thread(ready.wait, 3)
+            first = await client.get(path)
+            second = await client.get(path)
+            callbacks["stream_delta_callback"]("First ")
+            a, b = await asyncio.wait_for(asyncio.gather(first.content.readuntil(b"\n\n"), second.content.readuntil(b"\n\n")), 3)
+            assert decoded(a)["delta"] == decoded(b)["delta"] == "First "
+            assert decoded(a)["sequence"] == decoded(b)["sequence"]
+            sequence = decoded(a)["sequence"]
+            first.close()
+            callbacks["stream_delta_callback"]("second")
+            next_frame = decoded(await asyncio.wait_for(second.content.readuntil(b"\n\n"), 3))
+            assert next_frame["delta"] == "second"
+            assert next_frame["sequence"] > sequence
+            replay = await client.get(path, headers={"Last-Event-ID": str(sequence)})
+            assert decoded(await asyncio.wait_for(replay.content.readuntil(b"\n\n"), 3)) == next_frame
+            release.set()
+            endings = await asyncio.wait_for(asyncio.gather(second.text(), replay.text()), 3)
+            assert all("run.completed" in body and "First second" in body for body in endings)
+            terminal_replay = await client.get(path, headers={"Last-Event-ID": str(next_frame["sequence"])})
+            assert "run.completed" in await terminal_replay.text()
+            snapshot = await (await client.get(f"/v1/runs/{run_id}")).json()
+            assert snapshot["event_cursor"] > next_frame["sequence"]
+            assert snapshot["event_replay_floor"] <= sequence
+            invalid = await client.get(path, headers={"Last-Event-ID": "999999"})
+            assert invalid.status == 409
+            assert (await invalid.json())["error"]["code"] == "run_replay_gap"
+            denied = await client.get(path, headers={"Authorization": "Bearer wrong"})
+            assert denied.status == 401
+        finally:
+            release.set()
+            task = adapter._active_run_tasks.get(run_id)
+            if task is not None:
+                await asyncio.wait_for(asyncio.shield(task), 3)
+            adapter._run_idempotency_store.close()
+
+
+@pytest.mark.asyncio
+async def test_bounded_replay_reports_gaps_and_releases_shared_memory():
+    from gateway.platforms.api_server_run_events import ReplayGap, RunEventLog, RunEventPool
+
+    pool = RunEventPool(max_bytes=300, max_records=4)
+    first, second = RunEventLog(pool, max_events=2), RunEventLog(pool)
+    for index in range(8):
+        (first if index % 2 else second).put_nowait({"event": "message.delta", "delta": "x" * 40})
+        assert pool.bytes <= pool.max_bytes
+        assert len(pool.records) <= pool.max_records
+    with pytest.raises(ReplayGap):
+        await first.next(0)
+    # A client acknowledging the loss can continue from the reported watermark.
+    sequence, frame = await first.next(first.evicted_through)
+    assert decoded(frame)["sequence"] == sequence
+    second.release()
+    assert pool.bytes == first.bytes
+    first.release()
+    assert pool.bytes == 0
