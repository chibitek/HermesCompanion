+"""Event-loop-owned run replay with independent reader cursors.
+
+The TUI replay module is tied to process-global JSON-RPC session envelopes.
+This transport keeps adapter-owned HTTP run ownership and wakeups separate.
+"""
+import asyncio
+import json
+import weakref
+from collections import deque
+
+
+class ReplayGap(ValueError):
+    pass
+
+
+class RunEventPool:
+    def __init__(self, max_bytes=64 * 1024 * 1024, max_records=16384):
+        self.max_bytes = max_bytes
+        self.max_records = max_records
+        self.bytes = 0
+        self.records = deque()
+
+    def record(self, stream, sequence, size):
+        self.bytes += size
+        self.records.append((weakref.ref(stream), sequence))
+        while self.bytes > self.max_bytes or len(self.records) > self.max_records:
+            reference, through = self.records.popleft()
+            if (old := reference()) is not None:
+                old.evict_through(through)
+
+
+class RunEventLog:
+    MAX_EVENTS = 1024
+    MAX_BYTES = 4 * 1024 * 1024
+
+    def __init__(self, pool, *, max_events=MAX_EVENTS, max_bytes=MAX_BYTES):
+        self.pool = pool
+        self.max_events, self.max_bytes = max_events, max_bytes
+        self.events = deque()
+        self.bytes = self.sequence = self.evicted_through = 0
+        self.closed = False
+        self.subscribers = 0
+        self.changed = asyncio.Event()
+
+    def put_nowait(self, event):
+        if self.closed:
+            return
+        if event is None:
+            self.closed = True
+            self.changed.set()
+            return
+        self.sequence += 1
+        payload = {**event, "sequence": self.sequence}
+        frame = f"id: {self.sequence}\ndata: {json.dumps(payload)}\n\n".encode()
+        self.events.append((self.sequence, frame))
+        self.bytes += len(frame)
+        self.pool.record(self, self.sequence, len(frame))
+        while len(self.events) > self.max_events or self.bytes > self.max_bytes:
+            self.evict_through(self.events[0][0])
+        self.changed.set()
+
+    def evict_through(self, sequence):
+        while self.events and self.events[0][0] <= sequence:
+            removed, frame = self.events.popleft()
+            self.bytes -= len(frame)
+            self.pool.bytes -= len(frame)
+            self.evicted_through = removed
+        self.changed.set()
+
+    def validate_cursor(self, cursor):
+        if cursor < self.evicted_through or cursor > self.sequence:
+            raise ReplayGap(
+                f"Run events after {cursor} are no longer fully available; "
+                f"retained cursor range is {self.evicted_through}..{self.sequence}. "
+                "Refresh run status and saved conversation before resuming the event stream.")
+
+    async def next(self, cursor):
+        while True:
+            self.validate_cursor(cursor)
+            if self.events:
+                index = cursor - self.events[0][0] + 1
+                if 0 <= index < len(self.events):
+                    return self.events[index]
+            if self.closed:
+                return None
+            self.changed.clear()
+            await self.changed.wait()
+
+    def release(self):
+        self.evict_through(self.sequence)
+        self.closed = True
+        self.changed.set()
